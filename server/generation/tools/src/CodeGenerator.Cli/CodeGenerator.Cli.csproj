<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\version.props" />

  <ItemGroup>
    <ProjectReference Include="..\CodeGenerator.Core\CodeGenerator.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>code-generator-cli</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <StartupObject>CodeGenerator.Cli.Program</StartupObject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Code Generator CLI</Product>
    <Description>Command-line code generation tool (AI and automation entrypoint)</Description>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

</Project>
