{
   "name": "stencil",
   "version": "1.0.0",
   "private": true,
   "workspaces": [
      "frontend",
      "backend"
   ],
   "scripts": {
      "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
      "start:frontend": "npm --workspace=frontend start",
      "start:backend": "npm --workspace=backend run start:dev",
      "debug:backend": "npm --workspace=backend run start:debug",
      "install:all": "npm install",
      "build": "npm run build:frontend && npm run build:backend",
      "build:frontend": "npm --workspace=frontend run build",
      "build:backend": "npm --workspace=backend run build",
      "start:prod": "npm --workspace=backend run start:prod",
      "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
   },
   "devDependencies": {
      "@types/archiver": "^7.0.0",
      "@types/jest": "^29.5.14",
      "@types/js-cookie": "^3.0.6",
      "@types/react-modal": "^3.16.3",
      "concurrently": "^9.2.4",
      "eslint-plugin-prettier": "^5.5.5",
      "jest": "^29.7.0",
      "prettier": "^3.8.1",
      "ts-jest": "^29.4.6"
   },
   "dependencies": {
      "@aws-sdk/client-kms": "^3.1136.0",
      "@aws-sdk/credential-providers": "^3.1136.0",
      "@azure/identity": "^4.13.3",
      "@azure/keyvault-keys": "^4.10.0",
      "@lottiefiles/dotlottie-react": "^0.18.0",
      "@lottiefiles/lottie-types": "^1.5.0",
      "@noble/hashes": "^2.0.1",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/uuid": "^10.0.0",
      "archiver": "^7.0.1",
      "ioredis": "^5.9.3",
      "lodash": "^4.18.1",
      "mongodb": "~7.6.0",
      "mongodb-client-encryption": "^7.2.1",
      "rate-limiter-flexible": "^9.1.1",
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "tailwind-merge": "^3.5.0",
      "uuid": "^13.0.0"
   },
   "overrides": {
      "protobufjs": "7.6.6",
      "@protobufjs/utf8": "1.1.2",
      "handlebars": "4.7.9",
      "mongoose": "^9.10.1",
      "mongodb": "~7.6.0",
      "uuid": "^13.0.0",
      "shell-quote": "1.10.0",
      "websocket-driver": "0.7.5",
      "@grpc/grpc-js": "1.14.5",
      "fast-uri": "3.1.6",
      "fast-xml-parser": "5.11.1",
      "form-data": "4.0.6",
      "qs": "6.16.0",
      "multer": "2.4.0",
      "on-headers": "1.1.0",
      "body-parser": "2.3.0",
      "lodash": "^4.18.1",
      "axios": "^1.20.0",
      "postcss": "^8.5.28",
      "js-cookie": "^3.0.8",
      "browserslist": "4.29.0",
      "@babel/core": "7.29.7",
      "node-forge": "1.4.0",
      "serialize-javascript": "7.1.1",
      "flatted": "3.4.4",
      "follow-redirects": "1.16.0",
      "nanoid": "3.3.18",
      "ajv": "8.18.0",
      "postcss-selector-parser": "7.1.6",
      "rollup": "4.59.0",
      "yauzl": "3.4.0",
      "@humanfs/node": "0.17.0",
      "fast-xml-builder": "1.3.1"
   }
}
